# Firebase Web SDK public identifiers. These identify the web app but are not server secrets.
# Set all four values for Firebase mode. When unset, repositories can be used only for local development checks.
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Local E2E only. Leave unset for deployed builds.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8189

# Firebase Storage is intentionally not configured. Photos and videos are sent directly to
# the Worker for analysis, then discarded; Firestore stores form data and analysis metadata only.

# Optional public URL of the Cloudflare Worker proxy. Never place the OrcaRouter key here.
VITE_AI_WORKER_URL=https://your-pawpair-worker.workers.dev

# Never put an OrcaRouter API key in VITE_* variables. Browser variables are public.
