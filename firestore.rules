rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveFacility(facilityId) {
      return request.auth != null
        && request.auth.uid == facilityId
        && exists(/databases/$(database)/documents/facilities/$(facilityId))
        && get(/databases/$(database)/documents/facilities/$(facilityId)).data.active == true;
    }

    function axisScore(value) {
      return value is int && value >= 0 && value <= 100;
    }
    function validPersonalityAxes(axes) {
      // Boolean lists keep compound validation below the Rules expression limit.
      // Every entry must be true; guarded optional checks retain their own ORs.
      return [
        axes is map,
        axes.size() == 7,
        axisScore(axes.extraversion),
        axisScore(axes.sociability),
        axisScore(axes.neuroticism),
        axisScore(axes.trainability),
        axisScore(axes.resourceGuarding),
        axisScore(axes.assertiveness),
        axisScore(axes.resilience)
      ].hasOnly([true]);
    }
    function boundedText(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function validStructuredIntake(s) {
      return [
        s is map,
        s.size() == 18,
        s.neuter.matches('^(済み|未実施)$'),
        s.heat.matches('^(いいえ|はい)$'),
        s.mixedVaccine.matches('^(提出済み・有効|未提出|期限切れ)$'),
        s.rabiesVaccine.matches('^(提出済み・有効|未提出|期限切れ)$'),
        s.fleaTickPrevention.matches('^(実施済み|未実施)$'),
        s.foodAllergy.matches('^(なし|あり)$'),
        boundedText(s.medicalHistory, 1000),
        boundedText(s.sensoryJointConcerns, 1000),
        s.multiDogExperience.matches('^(なし|現在もあり|過去にあり)$'),
        s.facilityExperience.matches('^(月に数回|週に数回|ほぼ利用なし)$'),
        s.puppySocialization.matches('^(十分経験あり|少なめ|不明)$'),
        boundedText(s.troubleHistory, 1000),
        s.firstMeeting.matches('^(少し離れて様子を見る|様子を見てから近づく|すぐ近づいて遊びたがる|苦手そうにする|分からない)$'),
        s.playPreference.matches('^(追いかけたり追いかけられたり|追いかけるのが好き|体を使って遊ぶのが好き|おもちゃで遊ぶのが好き|あまり遊ばず見ている|分からない)$'),
        s.resourceReaction.matches('^(気にしない|少し気にすることがある|取られそうだと嫌がる|守ろうとすることがある|そういう場面がない|分からない)$'),
        s.excitement.matches('^(ゆっくりテンションが上がる|少しずつ盛り上がる|すぐに走り回るほど元気になる|吠えることがある|分からない)$'),
        s.recovery.matches('^(すぐ落ち着く|少し時間がかかる|かなり時間がかかる|状況による|分からない)$'),
        s.stressResponse.matches('^(すぐ切り替えられる|少し離れると落ち着く|長く気にする|吠えたり逃げたりする|分からない)$')
      ].hasOnly([true]);
    }
    function validIntakeConsent(c) {
      return [
        c is map,
        c.size() == 3,
        c.version == '2026-09',
        c.accepted == true,
        c.acceptedAt is string,
        c.acceptedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$')
      ].hasOnly([true]);
    }
    function intakeInviteIsValid(inviteId, facilityId) {
      let marker = get(/databases/$(database)/documents/registrationInvites/$(inviteId)).data;
      return marker.active == true && marker.facilityId == facilityId;
    }
    function validPet(data) {
      return data.keys().hasOnly(['name', 'breed', 'ageYears', 'weightKg', 'energyLevel', 'sociability', 'anxietyLevel', 'assertiveness', 'resourceGuarding', 'playStyles', 'hardBlockedPetIds', 'notes', 'photoUrl', 'updatedAt', 'personalityAxes'])
        && (!('personalityAxes' in data) || validPersonalityAxes(data.personalityAxes))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.ageYears is number && data.ageYears >= 0 && data.ageYears <= 40
        && data.weightKg is number && data.weightKg > 0 && data.weightKg <= 150
        && data.energyLevel is int && data.energyLevel >= 1 && data.energyLevel <= 5
        && data.sociability is int && data.sociability >= 1 && data.sociability <= 5
        && data.anxietyLevel is int && data.anxietyLevel >= 1 && data.anxietyLevel <= 5
        && data.assertiveness is int && data.assertiveness >= 1 && data.assertiveness <= 5
        && data.resourceGuarding is int && data.resourceGuarding >= 0 && data.resourceGuarding <= 5
        && data.playStyles is list && data.playStyles.size() <= 6
        && data.playStyles.hasOnly(['chase', 'wrestle', 'tug', 'fetch', 'gentle', 'solo'])
        && (!('breed' in data) || (data.breed is string && data.breed.size() <= 80))
        && (!('hardBlockedPetIds' in data) || (data.hardBlockedPetIds is list && data.hardBlockedPetIds.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && data.updatedAt is string && data.updatedAt.size() >= 20 && data.updatedAt.size() <= 40;
    }

    function validIntakeMedia(item, expectedKind, maxBytes) {
      return [
        item.keys().hasOnly(['kind', 'fileName', 'contentType', 'sizeBytes', 'status']),
        item.kind == expectedKind,
        item.fileName is string,
        item.fileName.size() > 0,
        item.fileName.size() <= 120,
        item.contentType is string,
        item.contentType.size() <= 80,
        item.contentType.matches(expectedKind == 'image' ? '^image/[a-zA-Z0-9.+-]+$' : '^video/[a-zA-Z0-9.+-]+$'),
        item.sizeBytes is int,
        item.sizeBytes >= 0,
        item.sizeBytes <= maxBytes,
        item.status in ['selected', 'uploaded', 'failed']
      ].hasOnly([true]);
    }
    function validIntakeMediaMap(media) {
      return media.keys().hasOnly(['photo', 'video'])
        && (!('photo' in media) || validIntakeMedia(media.photo, 'image', 5 * 1024 * 1024))
        && (!('video' in media) || validIntakeMedia(media.video, 'video', 20 * 1024 * 1024));
    }
    function validMatchingProfile(profile) {
      return [
        profile.keys().hasOnly(['energyLevel', 'sociability', 'anxietyLevel', 'assertiveness', 'resourceGuarding', 'playStyles', 'hardBlockedPetIds', 'personalityAxes']),
        (!('personalityAxes' in profile) || validPersonalityAxes(profile.personalityAxes)),
        profile.energyLevel is int,
        profile.energyLevel >= 1,
        profile.energyLevel <= 5,
        profile.sociability is int,
        profile.sociability >= 1,
        profile.sociability <= 5,
        profile.anxietyLevel is int,
        profile.anxietyLevel >= 1,
        profile.anxietyLevel <= 5,
        profile.assertiveness is int,
        profile.assertiveness >= 1,
        profile.assertiveness <= 5,
        profile.resourceGuarding is int,
        profile.resourceGuarding >= 0,
        profile.resourceGuarding <= 5,
        profile.playStyles is list,
        profile.playStyles.size() <= 6,
        profile.playStyles.hasOnly(['chase', 'wrestle', 'tug', 'fetch', 'gentle', 'solo']),
        profile.hardBlockedPetIds is list,
        profile.hardBlockedPetIds.size() <= 50
      ].hasOnly([true]);
    }
    function validAiAnalysis(ai) {
      return [
        ai.keys().hasOnly(['summary', 'observations', 'personalityTraits', 'compatibilitySignals', 'riskFlags', 'confidence', 'matchingProfile', 'personalityAxes']),
        (!('personalityAxes' in ai) || ai.personalityAxes == ai.matchingProfile.personalityAxes),
        ai.summary is string,
        ai.summary.size() <= 2000,
        ai.observations is list,
        ai.observations.size() <= 50,
        ai.personalityTraits is list,
        ai.personalityTraits.size() <= 30,
        ai.compatibilitySignals is list,
        ai.compatibilitySignals.size() <= 50,
        ai.riskFlags is list,
        ai.riskFlags.size() <= 50,
        ai.confidence is number,
        ai.confidence >= 0,
        ai.confidence <= 1,
        ai.matchingProfile is map,
        validMatchingProfile(ai.matchingProfile)
      ].hasOnly([true]);
    }
    function validIntake(data, intakeId, facilityId) {
      let p = data.pet;
      let o = data.owner;
      let structured = 'structured' in p;
      return [
        data.keys().hasOnly(['id', 'inviteId', 'facilityId', 'owner', 'pet', 'media', 'aiAnalysis', 'matchingProfile', 'status', 'submittedAt', 'consent']),
        (!(structured || 'consent' in data) || validIntakeConsent(data.consent)),
        (!structured || validStructuredIntake(p.structured)),
        (!structured || !('aiAnalysis' in data) || 'personalityAxes' in data.aiAnalysis),
        (!structured || !('matchingProfile' in data) || 'personalityAxes' in data.matchingProfile),
        data.id == intakeId,
        data.id == data.inviteId,
        data.inviteId is string,
        data.inviteId.matches('^[a-f0-9]{64}$'),
        data.facilityId == facilityId,
        o is map,
        o.size() == 2,
        o.name is string,
        o.name.size() > 0,
        o.name.size() <= 80,
        o.contact is string,
        o.contact.size() > 0,
        o.contact.size() <= 200,
        p is map,
        p.keys().hasOnly(['name', 'breed', 'ageYears', 'weightKg', 'sex', 'personality', 'playStyle', 'concerns', 'structured']),
        p.name is string,
        p.name.size() > 0,
        p.name.size() <= 40,
        p.breed is string,
        p.breed.size() > 0,
        p.breed.size() <= 80,
        p.ageYears is number,
        p.ageYears >= 0,
        p.ageYears <= 30,
        p.weightKg is number,
        p.weightKg >= 0.1,
        p.weightKg <= 100,
        p.sex in ['male', 'female', 'unknown'],
        p.personality is string,
        (structured || p.personality.size() > 0),
        p.personality.size() <= 1000,
        p.playStyle is string,
        (structured || p.playStyle.size() > 0),
        p.playStyle.size() <= 1000,
        p.concerns is string,
        p.concerns.size() <= 1000,
        data.media is map,
        validIntakeMediaMap(data.media),
        (!('aiAnalysis' in data) || (data.aiAnalysis is map && validAiAnalysis(data.aiAnalysis))),
        (!('matchingProfile' in data) || (('aiAnalysis' in data && data.matchingProfile == data.aiAnalysis.matchingProfile)
          || (!('aiAnalysis' in data) && data.matchingProfile is map && validMatchingProfile(data.matchingProfile)))),
        data.status in ['submitted', 'ready'],
        data.submittedAt is string,
        data.submittedAt.size() >= 20,
        data.submittedAt.size() <= 40
      ].hasOnly([true]);
    }

    function validMatchingSnapshot(data, snapshotId) {
      return data.keys().hasOnly(['id', 'status', 'petIds', 'pairResults', 'rooms', 'objectiveScore', 'createdAt'])
        && data.id == snapshotId && data.id.size() > 0 && data.id.size() <= 100
        && data.status in ['proposed', 'confirmed']
        && data.petIds is list && data.petIds.size() <= 20
        && data.pairResults is list && data.pairResults.size() <= 190
        && data.rooms is list && data.rooms.size() <= 10
        && (data.objectiveScore == null || data.objectiveScore is number)
        && data.createdAt is string && data.createdAt.size() >= 20 && data.createdAt.size() <= 40;
    }
    function validObservation(data, observationId) {
      return data.keys().hasOnly(['id', 'scenarioId', 'title', 'facts', 'impacts', 'recommendation', 'observedAt', 'source', 'staffId', 'petIds', 'operationDate'])
        && data.id == observationId && data.id.size() > 0 && data.id.size() <= 100
        && data.scenarioId is string && data.scenarioId.size() > 0 && data.scenarioId.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.facts is list && data.facts.size() <= 20
        && data.impacts is list && data.impacts.size() <= 20
        && data.recommendation is string && data.recommendation.size() <= 1000
        && data.observedAt is string && data.observedAt.size() >= 20 && data.observedAt.size() <= 40;
    }

    function operationId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,100}$');
    }
    function validManualObservation(data, observationId, facilityId) {
      let moment = timestamp.value(data.observedAt);
      let dayStart = timestamp.value(data.operationDate + 'T00:00:00+09:00');
      return validObservation(data, observationId) && data.size() == 11
        && data.source == 'manual' && data.scenarioId == 'manual'
        && operationActor(facilityId, data.staffId) && operationDate(data.operationDate)
        && operationTime(data.observedAt) && moment <= request.time
        && moment >= dayStart && moment < dayStart + duration.value(24, 'h')
        && data.facts.size() > 0
        && data.petIds is list && data.petIds.size() > 0 && data.petIds.size() <= 2
        && operationId(data.petIds[0]) && exists(/databases/$(database)/documents/facilities/$(facilityId)/demoPets/$(data.petIds[0]))
        && (data.petIds.size() == 1 || (operationId(data.petIds[1]) && data.petIds[0] != data.petIds[1]
          && exists(/databases/$(database)/documents/facilities/$(facilityId)/demoPets/$(data.petIds[1]))));
    }
    function operationDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function operationTime(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
    }
    function operationActor(facilityId, staffId) {
      return operationId(staffId)
        && get(/databases/$(database)/documents/facilities/$(facilityId)/staffProfiles/$(staffId)).data.active == true;
    }
    function operationPetIds(ids) {
      return ids is list && ids.size() <= 20 && ids.toSet().size() == ids.size();
    }
    function validRoom(room) {
      return [
        room is map,
        room.size() == 4,
        operationId(room.id),
        room.name is string,
        room.name.size() > 0,
        room.name.size() <= 100,
        room.capacity is int,
        room.capacity >= 1,
        room.capacity <= 20,
        room.minOccupancy is int,
        room.minOccupancy >= 0,
        room.minOccupancy <= room.capacity
      ].hasOnly([true]);
    }
    function roomAt(rooms, i) { return rooms.size() <= i || validRoom(rooms[i]); }
    function validRooms(rooms) {
      return [
        rooms is list,
        rooms.size() > 0,
        rooms.size() <= 10,
        roomAt(rooms, 0),
        roomAt(rooms, 1),
        roomAt(rooms, 2),
        roomAt(rooms, 3),
        roomAt(rooms, 4),
        roomAt(rooms, 5),
        roomAt(rooms, 6),
        roomAt(rooms, 7),
        roomAt(rooms, 8),
        roomAt(rooms, 9)
      ].hasOnly([true]);
    }
    function freshOperationAudit(facilityId, auditId, actor, time) {
      let path = /databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(auditId);
      let audit = getAfter(path).data;
      return operationId(auditId) && !exists(path)
        && audit.facilityId == facilityId && audit.staffId == actor && audit.createdAt == time;
    }
    function validDay(data, facilityId, date) {
      return data is map && data.size() == 8 && data.facilityId == facilityId && data.date == date
        && operationDate(date) && operationPetIds(data.selectedPetIds)
        && data.revision is int && data.revision > 0
        && (data.latestPlanId == null || operationId(data.latestPlanId))
        && operationTime(data.updatedAt) && operationActor(facilityId, data.updatedBy)
        && freshOperationAudit(facilityId, data.lastAuditId, data.updatedBy, data.updatedAt);
    }
    function validDayChange(data, facilityId, date) {
      let audit = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(data.lastAuditId)).data;
      return validDay(data, facilityId, date) && data.revision == resource.data.revision + 1
        && audit.date == date && audit.dayRevision == data.revision
        && ((audit.action == 'day_saved' && data.latestPlanId == resource.data.latestPlanId)
          || (audit.action in ['recalculated', 'confirmed', 'rejected']
            && data.selectedPetIds == resource.data.selectedPetIds
            && data.latestPlanId == audit.planId
            && (audit.action == 'recalculated' || data.latestPlanId == resource.data.latestPlanId)));
    }
    function validRoomSettings(data, facilityId) {
      let audit = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(data.lastAuditId)).data;
      return [
        data is map,
        data.size() == 6,
        data.facilityId == facilityId,
        data.revision is int,
        data.revision > 0,
        validRooms(data.rooms),
        operationTime(data.updatedAt),
        operationActor(facilityId, data.updatedBy),
        freshOperationAudit(facilityId, data.lastAuditId, data.updatedBy, data.updatedAt),
        audit.action == 'rooms_saved',
        audit.roomsRevision == data.revision
      ].hasOnly([true]);
    }
    function planBase(data, facilityId, planId) {
      return data is map && data.size() == 15 && data.id == planId && operationId(planId)
        && data.facilityId == facilityId && operationDate(data.date)
        && operationPetIds(data.petIds) && data.petIds.size() > 0
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && operationTime(data.createdAt) && operationTime(data.updatedAt)
        && operationActor(facilityId, data.staffId)
        && freshOperationAudit(facilityId, data.lastAuditId, data.staffId, data.updatedAt);
    }
    function oldProposalSuperseded(facilityId, oldId, auditId) {
      return oldId == null
        || get(/databases/$(database)/documents/facilities/$(facilityId)/operationPlans/$(oldId)).data.status != 'proposed'
        || (getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationPlans/$(oldId)).data.status == 'superseded'
          && getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationPlans/$(oldId)).data.lastAuditId == auditId);
    }
    function createOperationPlan(data, facilityId, planId) {
      let day = get(/databases/$(database)/documents/facilities/$(facilityId)/dailyOperations/$(data.date)).data;
      let nextDay = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/dailyOperations/$(data.date)).data;
      let settings = get(/databases/$(database)/documents/facilities/$(facilityId)/settings/rooms).data;
      let audit = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(data.lastAuditId)).data;
      return planBase(data, facilityId, planId) && data.status == 'proposed'
        && data.createdAt == data.updatedAt && data.petIds == day.selectedPetIds
        && data.rooms == settings.rooms && data.roomsRevision == settings.revision
        && data.dayRevision == day.revision + 1 && nextDay.revision == data.dayRevision
        && nextDay.latestPlanId == planId && nextDay.lastAuditId == data.lastAuditId
        && data.sourcePlanId == day.latestPlanId && oldProposalSuperseded(facilityId, day.latestPlanId, data.lastAuditId)
        && data.result is map && data.result.status == 'success'
        && data.result.rooms is list && data.result.rooms.size() <= 10
        && data.result.pairResults is list && data.result.pairResults.size() <= 190
        && audit.action == 'recalculated' && audit.planId == planId;
    }
    function updateOperationPlan(data, facilityId, planId) {
      let old = resource.data;
      let day = get(/databases/$(database)/documents/facilities/$(facilityId)/dailyOperations/$(old.date)).data;
      let nextDay = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/dailyOperations/$(old.date)).data;
      let settings = get(/databases/$(database)/documents/facilities/$(facilityId)/settings/rooms).data;
      let audit = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(data.lastAuditId)).data;
      return old.status == 'proposed' && day.latestPlanId == planId
        && data.diff(old).affectedKeys().hasOnly(['status', 'staffId', 'reason', 'updatedAt', 'lastAuditId'])
        && operationActor(facilityId, data.staffId) && operationTime(data.updatedAt)
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && freshOperationAudit(facilityId, data.lastAuditId, data.staffId, data.updatedAt)
        && nextDay.revision == day.revision + 1 && nextDay.lastAuditId == data.lastAuditId
        && ((data.status in ['confirmed', 'rejected'] && old.dayRevision == day.revision
          && old.roomsRevision == settings.revision && old.petIds == day.selectedPetIds
          && nextDay.latestPlanId == planId && audit.action == data.status && audit.planId == planId)
        || (data.status == 'superseded' && audit.action == 'recalculated'
          && audit.sourcePlanId == planId && nextDay.latestPlanId == audit.planId && audit.planId != planId));
    }
    function validOperationAudit(data, facilityId, auditId) {
      return data is map && data.size() == 11 && data.id == auditId && operationId(auditId)
        && data.facilityId == facilityId && operationActor(facilityId, data.staffId)
        && operationTime(data.createdAt) && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && (data.sourcePlanId == null || operationId(data.sourcePlanId))
        && (data.planId == null || operationId(data.planId))
        && (data.action == 'rooms_saved' ? roomsAuditLinked(data, facilityId) : dayAuditLinked(data, facilityId));
    }
    function roomsAuditLinked(audit, facilityId) {
      let rooms = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/settings/rooms).data;
      return audit.date == null && audit.dayRevision == null && audit.sourcePlanId == null && audit.planId == null
        && rooms.lastAuditId == audit.id && rooms.revision == audit.roomsRevision
        && rooms.updatedBy == audit.staffId && rooms.updatedAt == audit.createdAt;
    }
    function dayAuditLinked(audit, facilityId) {
      let day = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/dailyOperations/$(audit.date)).data;
      return operationDate(audit.date) && day.lastAuditId == audit.id && day.revision == audit.dayRevision
        && day.updatedBy == audit.staffId && day.updatedAt == audit.createdAt
        && ((audit.action == 'day_saved' && audit.planId == null && audit.roomsRevision == null && audit.sourcePlanId == day.latestPlanId)
          || (audit.action in ['recalculated', 'confirmed', 'rejected'] && planAuditLinked(audit, facilityId, day.latestPlanId)));
    }
    function planAuditLinked(audit, facilityId, planId) {
      let plan = getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationPlans/$(planId)).data;
      return audit.planId == planId && plan.lastAuditId == audit.id
        && plan.date == audit.date && plan.staffId == audit.staffId && plan.updatedAt == audit.createdAt
        && plan.reason == audit.reason && plan.roomsRevision == audit.roomsRevision
        && (audit.action == 'recalculated'
          ? (plan.status == 'proposed' && plan.sourcePlanId == audit.sourcePlanId)
          : (plan.status == audit.action && audit.sourcePlanId == planId));
    }

    function validPublicRegistrationInvite(data) {
      return data.keys().hasOnly(['active', 'facilityId'])
        && data.active == true
        && data.facilityId is string && data.facilityId.size() > 0 && data.facilityId.size() <= 128;
    }
    function validPrivateRegistrationInvite(data) {
      return data.keys().hasOnly(['staffId', 'createdAt'])
        && data.staffId is string && data.staffId.matches('^[A-Za-z0-9_-]{1,80}$')
        && data.createdAt is timestamp;
    }

    match /registrationInvites/{inviteHash} {
      allow get: if inviteHash.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create: if inviteHash.matches('^[a-f0-9]{64}$')
        && validPublicRegistrationInvite(request.resource.data)
        && isActiveFacility(request.resource.data.facilityId)
        && existsAfter(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)/registrationInvites/$(inviteHash));
      allow update, delete: if false;
    }

    match /facilities/{facilityId} {
      allow get: if isActiveFacility(facilityId);
      allow list, create, update, delete: if false;

      match /staffProfiles/{staffId} {
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId);
        allow create, update, delete: if false;
      }
      match /registrationInvites/{inviteHash} {
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 25;
        allow create: if isActiveFacility(facilityId)
          && inviteHash.matches('^[a-f0-9]{64}$')
          && validPrivateRegistrationInvite(request.resource.data)
          && exists(/databases/$(database)/documents/facilities/$(facilityId)/staffProfiles/$(request.resource.data.staffId))
          && get(/databases/$(database)/documents/facilities/$(facilityId)/staffProfiles/$(request.resource.data.staffId)).data.active == true
          && getAfter(/databases/$(database)/documents/registrationInvites/$(inviteHash)).data.facilityId == facilityId;
        allow update, delete: if false;
      }
      match /demoPets/{petId} {
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 26;
        allow create, update: if isActiveFacility(facilityId) && validPet(request.resource.data);
        allow delete: if false;
      }
      match /dailyOperations/{date} {
        allow get: if isActiveFacility(facilityId);
        allow list, delete: if false;
        allow create: if isActiveFacility(facilityId) && validDay(request.resource.data, facilityId, date)
          && request.resource.data.revision == 1 && request.resource.data.latestPlanId == null
          && getAfter(/databases/$(database)/documents/facilities/$(facilityId)/operationAudit/$(request.resource.data.lastAuditId)).data.action == 'day_saved';
        allow update: if isActiveFacility(facilityId) && validDayChange(request.resource.data, facilityId, date);
      }
      match /settings/rooms {
        allow get: if isActiveFacility(facilityId);
        allow list, delete: if false;
        allow create: if isActiveFacility(facilityId) && validRoomSettings(request.resource.data, facilityId) && request.resource.data.revision == 1;
        allow update: if isActiveFacility(facilityId) && validRoomSettings(request.resource.data, facilityId)
          && request.resource.data.revision == resource.data.revision + 1;
      }
      match /operationPlans/{planId} {
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 100;
        allow create: if isActiveFacility(facilityId) && createOperationPlan(request.resource.data, facilityId, planId);
        allow update: if isActiveFacility(facilityId) && updateOperationPlan(request.resource.data, facilityId, planId);
        allow delete: if false;
      }
      match /operationAudit/{auditId} {
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 100;
        allow create: if isActiveFacility(facilityId) && validOperationAudit(request.resource.data, facilityId, auditId);
        allow update, delete: if false;
      }
      match /demoIntakes/{intakeId} {
        allow create: if validIntake(request.resource.data, intakeId, facilityId)
          && intakeInviteIsValid(intakeId, facilityId);
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 25;
        allow update, delete: if false;
      }
      match /demoMatchingSnapshots/{snapshotId} {
        allow create: if isActiveFacility(facilityId) && validMatchingSnapshot(request.resource.data, snapshotId);
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 25;
        allow update, delete: if false;
      }
      match /demoObservations/{observationId} {
        allow create: if isActiveFacility(facilityId) && validManualObservation(request.resource.data, observationId, facilityId);
        allow get: if isActiveFacility(facilityId);
        allow list: if isActiveFacility(facilityId) && request.query.limit != null && request.query.limit <= 25;
        allow update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
